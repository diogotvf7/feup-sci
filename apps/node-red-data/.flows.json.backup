    {
        "id": "ecbe977dfea11a91",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Table Converter",
        "func": "let data = msg.payload;\nlet messages = [];\n\n// Clear the chart first\nmessages.push({\n    topic: \"Efficiency\",\n    payload: []\n});\n\n// Add all historical data points\ndata.forEach(point => {\n    let timestamp = new Date(point._time);\n    let timeLabel = timestamp.toLocaleTimeString('en-GB', { \n        hour: '2-digit', \n        minute: '2-digit' \n    });\n\n    messages.push({\n        topic: \"Efficiency\",\n        payload: Math.round(Number(point._value) * 100) / 100,\n        timestamp: timeLabel\n    });\n});\n\nmessages.forEach(m => node.send(m));\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1800,
        "y": 1180,
