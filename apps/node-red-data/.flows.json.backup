    {
        "id": "fdf45640cd1878a2",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Format Timestamps for Flux",
        "func": "// Helper: Parse Preset to Milliseconds\nfunction presetToMs(preset) {\n  if (!preset) return 0;\n  const unit = preset.slice(-1);\n  const val = parseInt(preset.slice(0, -1));\n  if (unit === 'm') return val * 60000;\n  if (unit === 'h') return val * 3600000;\n  if (unit === 'd') return val * 86400000;\n  return 0;\n}\n\n// 1. Handle Payload Structure\nlet formData = msg.payload || {};\n// If the payload is wrapped (from Loop Manager), unwrap it\nif (msg.payload.payload) formData = msg.payload.payload;\n\nlet startTime, endTime;\nlet presetValue = formData.Preset;\nlet frequencyValue = formData.Frequency;\n\n// 2. Determine Time Range (Start/Stop)\nif (presetValue && presetValue !== \"\") {\n  // PRESET MODE: Calculate start based on \"now\"\n  let msDuration = presetToMs(presetValue);\n  let now = Date.now();\n  endTime = now;\n  startTime = now - msDuration;\n} else {\n  // CUSTOM MODE: Use explicit Start/End times\n  startTime = new Date(formData.Start).getTime();\n  endTime = new Date(formData.End).getTime();\n\n  // Safety check\n  if (isNaN(startTime) || isNaN(endTime)) {\n    // Only error if we actually expected a custom range\n    if (!presetValue) return null;\n  }\n}\n\n// 3. Determine Aggregation Window (Frequency)\n// Use 'Frequency' from the dropdown for the window (e.g., \"5s\", \"1m\")\nlet windowPeriod = frequencyValue;\n\n// Safety: If frequency is missing or \"stop\" (manual update), default to 5s or 1m\nif (!windowPeriod || windowPeriod === \"stop\") {\n  windowPeriod = \"5s\";\n}\n\n// 4. Build Flux Query\nlet startISO = new Date(startTime).toISOString();\nlet endISO = new Date(endTime).toISOString();\n\nmsg.query = `\nfrom(bucket: \"iot_data\")\n  |> range(start: ${startISO}, stop: ${endISO})\n  |> filter(fn: (r) => r[\"_measurement\"] == \"distance\")\n  |> filter(fn: (r) => r[\"_field\"] == \"percentage\")\n  |> aggregateWindow(every: ${windowPeriod}, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")\n`;\n\nmsg.payload = msg.query;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 440,
