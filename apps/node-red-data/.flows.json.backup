        "z": "e8727e5e2e2a67dc",
        "name": "Table converter previsions",
        "func": "let data = msg.payload;\n\n// Create array of messages to send\nlet messages = [];\n\n// First message clears the chart\nmessages.push({\n    topic: \"previsions\",\n    payload: []\n});\n\nlet weekday = new Date()\n\nlet days = new Array('Sunday', 'Monday', 'Tuesday',\n    'Wednesday', 'Thursday', 'Friday', 'Saturday');\n\n// Add each data point as a separate message\ndata.forEach(point => {\n    weekday.setDate(weekday.getDate()+ 1)\n    messages.push({\n        topic: \"prevision\",\n        payload: Number(point._value),\n        timestamp: days[weekday.getDay()]\n    });\n});\n\n// Send all messages\nmessages.forEach(m => node.send(m));\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
