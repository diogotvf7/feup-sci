    {
        "id": "38c24e3684987837",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Update Sender",
        "func": "let data = msg.payload;\n\nif (data && data[0]._time != flow.get(\"dynamo_last_val\")) {\n    let point = data[0];\n\n    flow.set(\"dynamo_last_val\", point._timestamp)\n\n    return {\n        topic: \"energy_produced\",\n        payload: Number(point._value),\n        timestamp: new Date(point._time).getTime()\n    };\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1160,
        "y": 460,
        "wires": [
