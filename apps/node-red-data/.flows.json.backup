        "name": "Dynamo_live gate",
        "func": "if (flow.get(\"dynamo_live\")){\n  msg.query = `\n  from(bucket: \"iot_data\")\n    |> range(start: 0)\n    |> filter(fn: (r) => r[\"_measurement\"] == \"dynamo\")\n    |> filter(fn: (r) => r[\"_field\"] == \"value\")\n    |> last()\n  `;\n\n  msg.payload = msg.query;\n  return msg;\n}\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
