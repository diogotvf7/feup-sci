                "3f951c7b06d10c1c"
            ]
        ]
    },
    {
        "id": "f185d49d000574de",
        "type": "function",
        "z": "8350cc1f7811e02f",
        "name": "Check Flow > 400",
        "func": "if (msg.payload.data > 400) {\n    msg.payload = \"WARNING: High flow rate detected! \" + msg.payload.data + \"L/h\";\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
