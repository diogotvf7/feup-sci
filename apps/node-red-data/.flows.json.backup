    {
        "id": "8614b05b0b448e5e",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Calculate %",
        "func": "// CONFIGURATION\nconst distBottom = 1000; // 0% Level (cm/mm)\nconst distFull = 10;     // 100% Level (cm/mm)\nconst limit30s = 30 * 1000; // 30 seconds in ms\n\nlet distWater;\n\n// --- 1. Determine Distance (Single vs Average) ---\nif (Array.isArray(msg.payload)) {\n    if (msg.payload.length === 0) return null; // Protect against empty arrays\n\n    // *** FIX: Initialize qResult as an empty array first ***\n    msg.qResult = [];\n\n    // A. Find the latest timestamp in the dataset\n    let maxTime = 0;\n    for (let i = 0; i < msg.payload.length; i++) {\n        let t = new Date(msg.payload[i]._time).getTime();\n        if (t > maxTime) maxTime = t;\n    }\n\n    msg.maxTime = new Date(maxTime).toLocaleTimeString();\n    msg.maxTime = new Date(maxTime);\n    msg.qResult1 = msg.payload;\n    // B. Calculate Average only for records within 30s of maxTime\n    let sum = 0;\n    let count = 0;\n\n    for (let i = 0; i < msg.payload.length; i++) {\n        let recordTime = new Date(msg.payload[i]._time).getTime();\n        // Check if record is within the 30s window relative to the latest record\n        if ((maxTime - recordTime) <= limit30s) {\n            sum += msg.payload[i]._value;\n            count++;\n            msg.qResult.push(msg.payload[i]); // Now this works because qResult is []\n        }\n    }\n\n    if (count > 0) {\n        distWater = sum / count;\n    } else {\n        return null;\n    }\n\n} else {\n    // Not an array: Use _value directly (or payload if scalar)\n    msg.qResult = [msg.payload]; // Wrap in array for consistency\n    distWater = (msg.payload && msg.payload._value !== undefined) ? msg.payload._value : msg.payload;\n}\n\n// --- 2. Calculate Percentage ---\nif (distWater !== undefined && distWater !== null) {\n    let percentage = distWater;\n\n    // --- DEBUGGING ---\n    msg.debug = {\n        \"Raw Percentage\": percentage,\n    };\n\n    msg.payload = parseFloat(percentage.toFixed(1));\n    return msg;\n}",
