    {
        "id": "a1fbde1dc024bc70",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "query_builder_flow_rate",
        "func": "let range;\n\nif (!msg.timePreset || msg.timePreset == 0) {\n  range = 'range(start: 0)';\n} else {\n  range = `range(start: -${msg.timePreset})`;\n}\n\nmsg.query = `\nfrom(bucket: \"iot_data\")\n  |> ${range}\n  |> filter(fn: (r) => r[\"_measurement\"] == \"flow_rate\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: true)\n`;\n\nmsg.topic = \"flow_rate\";\nmsg.payload = msg.query;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
        "y": 1180,
        "wires": [
