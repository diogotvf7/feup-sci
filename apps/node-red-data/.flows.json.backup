    {
        "id": "34c8833e10a36fe0",
        "type": "function",
        "z": "a29502919b85aa46",
        "name": "Table converter Pluviometer",
        "func": "let data = msg.payload;\n\n// Create array of messages to send\nlet messages = [];\n\n// First message clears the chart\nmessages.push({\n    topic: \"rainfall\",\n    payload: []\n});\n\n// Add each data point as a separate message\ndata.forEach(point => {\n    messages.push({\n        topic: \"rainfall\",\n        payload: Number(point._value),\n        timestamp: new Date(point._time)\n    });\n});\n\n// Send all messages\nmessages.forEach(m => node.send(m));\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1480,
        "y": 300,
        "wires": [
            [
                "429a713004e1883a",
                "77e850b5e645eb40"
            ]
        ]
    },
    {
        "id": "3138a9a995d5a215",
        "type": "function",
        "z": "a29502919b85aa46",
        "name": "query_builder_pluviometer",
        "func": "let range;\n\nif (!msg.timePreset || msg.timePreset == 0) {\n  range = 'range(start: 0)';\n} else {\n  range = `range(start: - ${msg.timePreset})`;\n}\n\nmsg.query = `\nfrom(bucket: \"iot_data\")\n  |> ${range}\n  |> filter(fn: (r) => r[\"_measurement\"] == \"pluviometer\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n`;\n\nmsg.payload = msg.query;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 320,
        "wires": [
            [
                "931dd7e3f4112d96"
            ]
        ]
    },
