        "id": "5ec70c3a81b9df07",
        "type": "function",
        "z": "a29502919b85aa46",
        "name": "Update Sender",
        "func": "let data = msg.payload;\n\nif (data && data[0]._time != flow.get(\"pluviometer_last_val\")) {\n    let point = data[0];\n\n    flow.set(\"pluviometer_last_val\", point._timestamp)\n\n    return {\n        topic: \"rainfall\",\n        payload: Number(point._value),\n        timestamp: new Date(point._time).getTime()\n    };\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
