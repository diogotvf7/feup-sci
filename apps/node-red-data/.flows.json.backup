    {
        "id": "425cf587a373a3e2",
        "type": "function",
        "z": "8350cc1f7811e02f",
        "g": "61b3cab9e50b62c7",
        "name": "Format for InfluxDB",
        "func": "// CONFIGURATION: Adjust these to match your tank\nconst distBottom = 10.14; // Distance when empty (0%)\nconst distFull = 3.25;     // Distance when full (100%)\n\nfunction ToLocalDate(inDate) {\n    return new Date(inDate * 1000);\n}\n\n// 1. Initialize Fields Object with the standard 'value'\nlet fields = {\n    value: msg.payload.data\n};\n\n// 2. Conditional Logic: Calculate Percentage ONLY for Distance/cm\nif (msg.payload.kind === \"distance\" && msg.payload.units === \"cm\") {\n    let currentDistance = msg.payload.data;\n\n    if (currentDistance == 0.0){\n        return null;\n    }\n\n    if (currentDistance !== undefined && currentDistance !== null) {\n        let percentage = ((distBottom - currentDistance) / (distBottom - distFull)) * 100;\n\n        // Clamp between 0 and 100\n        percentage = Math.max(0, Math.min(100, percentage));\n\n        // Add percentage to the fields object\n        fields.percentage = parseFloat(percentage.toFixed(1));\n    }\n}\n\n// 3. Set the Measurement Name\nmsg.measurement = msg.payload.kind;\n\n// 4. Define Payload [Fields, Tags]\nmsg.payload = [\n    fields,\n    {\n        // TAGS: Metadata for filtering\n        sensor_id: msg.payload.id,\n        units: msg.payload.units\n    }\n];\n\n// 5. Override the \"Now\" time\nmsg.timestamp = ToLocalDate(msg.payload.time_stamp);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 260,
        "wires": [
            [
                "cc62b281b9e13b32",
                "42a30455316dd6a2"
            ]
        ]
    },
