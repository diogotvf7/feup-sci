    {
        "id": "8dbe2d0a5c821433",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Query for FlowRate ",
        "func": "msg.query = `\nfrom(bucket: \"iot_data\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"flow_rate\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()\n`;\n\n// Set msg.payload to the query, which the influxdb in node will execute.\nmsg.payload = msg.query;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 140,
        "wires": [
            [
                "b3ca2013997bec19"
            ]
        ]
    },
    {
        "id": "2fd5f9d98f8cb2cd",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Calculate Flow Rate",
        "func": "// CONFIGURATION\nconst limit30s = 30 * 1000; // 30 seconds window for averaging\n\nlet avgFlowRaw; // Average Flow in raw units\nlet currentUnit = \"\"; // To store the unit found in the payload\n\n// --- 1. Determine Average Flow (Raw) for recent data ---\nif (Array.isArray(msg.payload)) {\n    if (msg.payload.length === 0) return null;\n\n    msg.qResult = [];\n\n    // A. Find the latest timestamp\n    let maxTime = 0;\n    for (let i = 0; i < msg.payload.length; i++) {\n        let t = new Date(msg.payload[i]._time).getTime();\n        if (t > maxTime) maxTime = t;\n    }\n\n    msg.maxTime = new Date(maxTime);\n\n    // B. Calculate Average only for records within 30s of maxTime\n    let sum = 0;\n    let count = 0;\n\n    for (let i = 0; i < msg.payload.length; i++) {\n        let recordTime = new Date(msg.payload[i]._time).getTime();\n\n        if ((maxTime - recordTime) <= limit30s) {\n            sum += msg.payload[i]._value;\n            count++;\n            msg.qResult.push(msg.payload[i]);\n        }\n    }\n\n    if (count > 0) {\n        avgFlowRaw = sum / count;\n        // Grab the unit from the first record used in the average\n        currentUnit = msg.qResult[0].units;\n    } else {\n        return null;\n    }\n\n} else {\n    // Single value case\n    msg.qResult = [msg.payload];\n    avgFlowRaw = (msg.payload && msg.payload._value !== undefined) ? msg.payload._value : msg.payload;\n    // Check if units exist on the payload object, otherwise default empty\n    currentUnit = (msg.payload && msg.payload.units) ? msg.payload.units : \"\";\n    msg.maxTime = new Date().toLocaleTimeString();\n}\n\n// --- 2. Convert to m³/s if necessary ---\nif (avgFlowRaw !== undefined && avgFlowRaw !== null) {\n\n    let flow_m3s = avgFlowRaw;\n\n    // Check unit and convert if it is L/hour\n    // Using toLowerCase() to be safe against \"L/Hour\", \"l/hour\", etc.\n    if (currentUnit && currentUnit.toLowerCase() === \"l/hour\") {\n        // Conversion: 1 L/h = 1 / 3,600,000 m³/s\n        flow_m3s = avgFlowRaw / 3600000;\n    }\n\n    // --- DEBUGGING ---\n    msg.debug = {\n        \"Raw Average\": avgFlowRaw,\n        \"Detected Unit\": currentUnit,\n        \"Final Flow (m3/s)\": flow_m3s\n    };\n\n    msg.payload = Number(avgFlowRaw);\n\n    \n\n    return msg;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1160,
        "y": 100,
        "wires": [
            [
                "a116ea9b44a0df79",
                "cc36ed558a56d4a2"
            ]
        ]
    },
