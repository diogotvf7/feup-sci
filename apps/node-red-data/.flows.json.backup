    {
        "id": "87c6999a463d1825",
        "type": "function",
        "z": "72c28959539b9464",
        "name": "Format Timestamps for Flux",
        "func": "// Function to convert time strings (e.g., \"1h\", \"30m\") to milliseconds\nfunction presetToMs(preset) {\n  const unit = preset.slice(-1); // m, h, d, w\n  const value = parseInt(preset.slice(0, -1));\n\n  const MS_PER_MINUTE = 60 * 1000;\n  const MS_PER_HOUR = MS_PER_MINUTE * 60;\n  const MS_PER_DAY = MS_PER_HOUR * 24;\n  const MS_PER_WEEK = MS_PER_DAY * 7;\n\n  switch (unit) {\n    case 'm': return value * MS_PER_MINUTE;\n    case 'h': return value * MS_PER_HOUR;\n    case 'd': return value * MS_PER_DAY;\n    case 'w': return value * MS_PER_WEEK;\n    default: return 0;\n  }\n}\n\nlet startTime;\nlet endTime;\nlet presetValue = msg.payload.Preset;\n\n// --- 1. Determine Start and End Times ---\nif (presetValue) {\n  // If a preset is selected, use it.\n  let msDuration = presetToMs(presetValue);\n\n  // End time is always now (current timestamp in milliseconds)\n  let now = Date.now();\n  endTime = now;\n\n  // Start time is calculated: now - duration\n  startTime = now - msDuration;\n\n  // The `datetime-local` input type returns milliseconds, so we use them here.\n} else {\n  // If no preset is selected, use the custom Start/End times from the form.\n  // The ui-form returns epoch milliseconds for 'datetime-local' type.\n  startTime = msg.payload.Start;\n  endTime = msg.payload.End;\n\n  // Optional: Add logic here to require custom fields if no preset is selected.\n  if (!startTime || !endTime) {\n    node.error(\"Please select a time preset or provide both Start and End times.\");\n    return null; // Stop the flow\n  }\n}\n\n// Convert times to ISO strings for use in the Flux query.\nlet start_time_iso = new Date(startTime).toISOString();\nlet end_time_iso = new Date(endTime).toISOString();\n\n// --- 2. Build the Flux Query String ---\n// Define an aggregation window (e.g., 5 minutes = 5m). \nlet window_period = \"5m\";\n\n// Construct the full Flux query string.\nmsg.query = `\nfrom(bucket: \"iot_data\")\n  |> range(start: ${start_time_iso}, stop: ${end_time_iso})\n  |> filter(fn: (r) => r[\"_measurement\"] == \"distance\")\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\n  |> yield(name: \"mean at 30s\")\n`;\n\n//  |> filter(fn: (r) => r[\"_measurement\"] == \"flow_rate\" or r[\"_measurement\"] == \"distance\")\n\n// Set msg.payload to the query, which the influxdb in node will execute.\nmsg.payload = msg.query;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
