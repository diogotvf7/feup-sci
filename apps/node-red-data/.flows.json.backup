    {
        "id": "aaed50a4d8d3a6a4",
        "type": "switch",
        "z": "8350cc1f7811e02f",
        "name": "Filter by Kind",
        "property": "payload.kind",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
