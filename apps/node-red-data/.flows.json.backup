    {
        "id": "cbcec2b825dabb8d",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Format to Chart",
        "func": "const sensorNames = {\n    \"3ade6e09-3365-45a2-abca-1a01611ab078\": \"Tank Main Sensor\",\n    \"99999999-aaaa-bbbb-cccc-dddddddddddd\": \"Tank Backup Sensor\"\n};\n\nif (!Array.isArray(msg.payload)) return null;\n\n\nnode.send({ payload: [], reset: true });\n\nmsg.payload.forEach(p => {\n    node.send({\n        topic: sensorNames[p.sensor_id] || p.sensor_id,\n        payload: {\n            x: new Date(p._time).getTime(),\n            y: Number(p._value)\n        }\n    });\n});\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1300,
        "y": 340,
        "wires": [
