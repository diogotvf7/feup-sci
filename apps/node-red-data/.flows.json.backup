    {
        "id": "d7d620bbd29a5d20",
        "type": "mqtt in",
        "z": "8350cc1f7811e02f",
        "g": "61b3cab9e50b62c7",
        "name": "sensors/#",
        "topic": "sensors/#",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "cb8de0ba66af2b18",
