    {
        "id": "6fc47d608ec44fe0",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Efficiency calculator Live version",
        "func": "// Store data from each query\nlet dynamoData = flow.get(\"efficiency_live_dynamo\");\nlet waterData = flow.get(\"efficiency_live_water\");\nlet lastDynamoTime = flow.get(\"last_dynamo_time\");\nlet lastWaterTime = flow.get(\"last_water_time\");\n\n// Store incoming data based on topic\nif (msg.topic === \"dynamo\") {\n    if (msg.payload && msg.payload.length > 0) {\n        let newTime = new Date(msg.payload[0]._time).getTime();\n\n        // Only update if this is new data\n        if (newTime !== lastDynamoTime) {\n            flow.set(\"efficiency_live_dynamo\", msg.payload[0]);\n            flow.set(\"last_dynamo_time\", newTime);\n            dynamoData = msg.payload[0];\n        } else {\n            // No new data, don't proceed\n            return null;\n        }\n    } else {\n        return null;\n    }\n} else if (msg.topic === \"flow_rate\") {\n    if (msg.payload && msg.payload.length > 0) {\n        let newTime = new Date(msg.payload[0]._time).getTime();\n\n        // Only update if this is new data\n        if (newTime !== lastWaterTime) {\n            flow.set(\"efficiency_live_water\", msg.payload[0]);\n            flow.set(\"last_water_time\", newTime);\n            waterData = msg.payload[0];\n        } else {\n            // No new data, don't proceed\n            return null;\n        }\n    } else {\n        return null;\n    }\n} else {\n    return null;\n}\n\n// Check if we have both datasets\nif (!dynamoData || !waterData) {\n    return null;\n}\n\n// Check if at least one of them was just updated\nlet dynamoTime = new Date(dynamoData._time).getTime();\nlet waterTime = new Date(waterData._time).getTime();\n\n// Use the most recent timestamp\nlet mostRecentTime = Math.max(dynamoTime, waterTime);\n\n// Check if water value is valid\nif (waterData._value <= 0) {\n    return null;\n}\n\n// Calculate efficiency\nlet efficiency = dynamoData._value / waterData._value;\n\nreturn {\n    payload: [{\n        _time: new Date(mostRecentTime).toISOString(),\n        _value: efficiency\n    }],\n    topic: \"efficiency_calculated\"\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1450,
        "y": 1340,
        "wires": [
            [
                "4d9725d7043c15da"
            ]
        ]
    },
    {
        "id": "4d9725d7043c15da",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Update Sender Efficiency",
        "func": "let data = msg.payload;\n\nif (!data || data.length === 0) {\n    return null;\n}\n\n// Send each new data point\ndata.forEach(point => {\n    let timestamp = new Date(point._time);\n    let timeLabel = timestamp.toLocaleTimeString('en-GB', {\n        hour: '2-digit',\n        minute: '2-digit'\n    });\n\n    node.send({\n        topic: \"Efficiency\",\n        payload: Math.round(Number(point._value) * 100) / 100,\n        timestamp: timeLabel\n    });\n});\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1770,
        "y": 1340,
        "wires": [
            [
                "7f3c113001477002"
            ]
        ]
    },
