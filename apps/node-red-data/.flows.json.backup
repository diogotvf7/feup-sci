    {
        "id": "28c2f7eb18d484a7",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Efficiency calculator",
        "func": "// Store data from each query\nlet dynamoData = flow.get(\"efficiency_dynamo_data\");\nlet waterData = flow.get(\"efficiency_water_data\");\n\n// Store incoming data based on topic\nif (msg.topic === \"dynamo\") {\n    flow.set(\"efficiency_dynamo_data\", msg.payload);\n    dynamoData = msg.payload;\n} else if (msg.topic === \"flow_rate\") {\n    flow.set(\"efficiency_water_data\", msg.payload);\n    waterData = msg.payload;\n} else {\n    return null;\n}\n\n// Wait until we have both datasets\nif (!dynamoData || !waterData || dynamoData.length === 0 || waterData.length === 0) {\n    return null;\n}\n\n// Create lookup map for water data by timestamp\nlet waterMap = {};\nwaterData.forEach(w => {\n    let timeKey = new Date(w._time).getTime();\n    // Round to nearest minute to handle slight differences\n    timeKey = Math.floor(timeKey / 60000) * 60000;\n    waterMap[timeKey] = w._value;\n});\n\n// Calculate efficiency for matching timestamps\nlet efficiencyData = [];\ndynamoData.forEach(d => {\n    let timeKey = new Date(d._time).getTime();\n    timeKey = Math.floor(timeKey / 60000) * 60000;\n    \n    if (waterMap[timeKey] && waterMap[timeKey] > 0) {\n        efficiencyData.push({\n            _time: d._time,\n            _value: d._value / waterMap[timeKey]\n        });\n    }\n});\n\n// Clear stored data\nflow.set(\"efficiency_dynamo_data\", null);\nflow.set(\"efficiency_water_data\", null);\n\nmsg.payload = efficiencyData;\nmsg.topic = \"efficiency_calculated\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1550,
        "y": 1140,
        "wires": [
            [
                "42185668cf11740b",
                "ecbe977dfea11a91"
            ]
        ]
    },
