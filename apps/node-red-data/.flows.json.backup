        "id": "5d346a99138cdccd",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Publish total",
        "func": "msg.query = `\nfrom(bucket: \"iot_data\")\n  |> range(start: - 1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"dynamo\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false)\n`;\n\nmsg.payload = msg.query;\nreturn msg;\n",
