    {
        "id": "988668c67692fb47",
        "type": "function",
        "z": "8350cc1f7811e02f",
        "name": "Check Distance < 10",
        "func": "if (msg.payload.data < 10) {\n    msg.payload = \"ALARM: Object too close! \" + msg.payload.data + \"cm\";\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 440,
        "wires": [
