    {
        "id": "21809eeeefc5019c",
        "type": "function",
        "z": "f279411eb433cfda",
        "name": "Table converter dynamo",
        "func": "let data = msg.payload;\n\n// Create array of messages to send\nlet messages = [];\n\n// First message clears the chart\nmessages.push({\n    topic: \"energy_produced\",\n    payload: []\n});\n\n// Add each data point as a separate message\ndata.forEach(point => {\n    messages.push({\n        topic: \"energy_produced\",\n        payload: Number(point._value),\n        timestamp: new Date(point._time)\n    });\n});\n\n// Send all messages\nmessages.forEach(m => node.send(m));\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
