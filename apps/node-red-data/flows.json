    {
        "id": "e2a141fbeb622391",
        "type": "function",
        "z": "122b6eb0d33a29f5",
        "name": "Loop Manager",
        "func": "// Helper to parse \"5s\", \"1m\" to milliseconds\nfunction getMs(str) {\n    if (!str) return 5000;\n    let unit = str.slice(-1);\n    let val = parseInt(str.slice(0, -1));\n    if (unit === 's') return val * 1000;\n    if (unit === 'm') return val * 60000;\n    if (unit === 'h') return val * 3600000;\n    if (unit === 'd') return val * 86400000;\n    return 5000;\n}\n\n// --- 1. Save Configuration ---\n// Check if this message comes from the Form (has a Preset)\nif (msg.payload && msg.payload.Preset !== undefined) {\n    // Save the CONTENT of the payload (the form data)\n    context.set('lastConfig', msg.payload);\n}\n\n// --- 2. Handle STOP Command ---\nif (msg.payload && msg.payload.Frequency === \"stop\") {\n    context.set('interval', null);\n\n    // If this stop command came with form data, run it once.\n    let output2 = (msg.payload.Preset !== undefined) ? msg : null;\n\n    return [{ reset: true }, output2, null];\n}\n\n// --- 3. Handle New Frequency (Start/Update Loop) ---\nif (msg.payload && msg.payload.Frequency) {\n    let interval = getMs(msg.payload.Frequency);\n    context.set('interval', interval);\n\n    // Output 1: Reset Delay\n    // Output 2: Fire Query Immediately (Pass the full 'msg')\n    // Output 3: Start Loop\n    return [\n        { reset: true },\n        msg,\n        { payload: \"loop\", delay: interval }\n    ];\n}\n\n// --- 4. Handle The Loop Trigger ---\nif (msg.payload === \"loop\") {\n    let interval = context.get('interval');\n\n    // If stopped, do nothing\n    if (!interval) return null;\n\n    // Retrieve the saved form data\n    let lastConfig = context.get('lastConfig');\n\n    // Safety: If no config saved, stop.\n    if (!lastConfig) return null;\n\n    // *** FIX IS HERE ***\n    // We must wrap the config back into a 'payload' property\n    let newMsg = { payload: lastConfig };\n\n    return [\n        null,\n        newMsg,\n        { payload: \"loop\", delay: interval }\n    ];\n}",
